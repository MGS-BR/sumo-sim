{
  "name": "sumo-sim-500g",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador web de Mini Sumô 500g (regulamento RoboCore) com física 3D em escala real",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "npm run typecheck && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "analise": "vitest run analysis --exclude analysis/motorFit.test.ts --exclude analysis/battery.test.ts --silent=false",
    "analise:motores": "vitest run analysis/motorFit.test.ts --silent=false",
    "analise:baterias": "vitest run analysis/battery.test.ts --silent=false"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
